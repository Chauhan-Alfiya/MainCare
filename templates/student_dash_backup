<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Student Dashboard | MindCare</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --brand-dark-teal: #0e4a5c;
            --brand-deep-navy: #06232d;
            --brand-mint: #2dd4bf;
            --brand-mint-hover: #14b8a6;
            --bg-canvas: #f0f4f8;
            --card-border: #e2e8f0;
        }

        body {
            background-color: var(--bg-canvas);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            color: #1e293b;
        }

        /* Landing Page Matched Navbar */
        .portal-navbar {
            background: #ffffff;
            border-bottom: 1px solid var(--card-border);
            padding: 16px 40px;
        }

        .brand-text {
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--brand-dark-teal);
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav-links-menu a {
            color: #334155;
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            transition: color 0.2s ease;
            padding: 6px 12px;
        }

        .nav-links-menu a:hover,
        .nav-links-menu a.active {
            color: var(--brand-dark-teal);
        }

        /* Profile Avatar Trigger Button */
        .avatar-circle {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--brand-dark-teal);
            color: #ffffff;
            font-weight: 700;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border: 2px solid #ffffff;
            box-shadow: 0 3px 10px rgba(14, 74, 92, 0.2);
            transition: all 0.2s ease;
        }

        .avatar-circle:hover {
            transform: scale(1.05);
            background: var(--brand-mint-hover);
        }

        /* Hero Banner */
        .hero-section {
            background: linear-gradient(135deg, var(--brand-deep-navy) 0%, var(--brand-dark-teal) 100%);
            color: #ffffff;
            padding: 55px 20px 95px 20px;
            border-bottom-left-radius: 28px;
            border-bottom-right-radius: 28px;
            text-align: center;
        }

        .hero-badge {
            background: rgba(45, 212, 191, 0.15);
            color: var(--brand-mint);
            padding: 8px 20px;
            border-radius: 30px;
            font-size: 0.82rem;
            font-weight: 600;
            display: inline-block;
            backdrop-filter: blur(6px);
            margin-bottom: 18px;
            border: 1px solid rgba(45, 212, 191, 0.25);
        }

        .btn-mint {
            background-color: var(--brand-mint-hover);
            color: #ffffff;
            font-weight: 600;
            border-radius: 30px;
            padding: 12px 30px;
            border: none;
            transition: all 0.2s ease;
            font-size: 0.95rem;
        }

        .btn-mint:hover {
            background-color: #0d9488;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(20, 184, 166, 0.3);
        }

        .btn-outline-mint {
            border: 2px solid rgba(255, 255, 255, 0.6);
            color: #ffffff;
            font-weight: 600;
            border-radius: 30px;
            padding: 12px 30px;
            transition: all 0.2s ease;
            font-size: 0.95rem;
        }

        .btn-outline-mint:hover {
            background: rgba(255, 255, 255, 0.15);
            color: #ffffff;
            border-color: #ffffff;
            transform: translateY(-2px);
        }

        /* Dashboard Floating Layout */
        .dashboard-container {
            margin-top: -55px;
            padding-bottom: 60px;
        }

        .card-custom {
            background: #ffffff;
            border: 1px solid var(--card-border);
            border-radius: 18px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .card-custom:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
        }

        /* Offcanvas Sidebar */
        .account-offcanvas {
            width: 330px !important;
            border-top-left-radius: 24px;
            border-bottom-left-radius: 24px;
            border: none;
            background: #ffffff;
            box-shadow: -10px 0 30px rgba(0, 0, 0, 0.08);
        }

        .profile-card-box {
            background: linear-gradient(135deg, #f0fdfa 0%, #e6f4f8 100%);
            border-radius: 20px;
            padding: 24px 20px;
            text-align: center;
            border: 1px solid #ccfbf1;
            margin-bottom: 20px;
        }

        .profile-avatar-large {
            width: 75px;
            height: 75px;
            background: var(--brand-dark-teal);
            color: #ffffff;
            font-size: 2rem;
            font-weight: 800;
            border-radius: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 12px auto;
            box-shadow: 0 6px 16px rgba(14, 74, 92, 0.25);
        }

        .sidebar-menu-card {
            background-color: #f8fafc;
            border-radius: 14px;
            padding: 14px 18px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-decoration: none;
            color: #334155;
            font-weight: 600;
            font-size: 0.92rem;
            transition: all 0.2s ease;
        }

        .sidebar-menu-card:hover {
            background-color: #ffffff;
            border-color: #cbd5e1;
            color: var(--brand-dark-teal);
            box-shadow: 0 4px 12px rgba(14, 74, 92, 0.06);
        }

        .table-custom th {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            background: #f8fafc;
            padding: 12px 16px;
        }

        .table-custom td {
            padding: 16px;
            vertical-align: middle;
        }

        .mood-pill {
            border: 2px solid var(--card-border);
            border-radius: 12px;
            padding: 14px;
            text-align: center;
            background: #fff;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .mood-pill:hover, .mood-pill.active {
            border-color: var(--brand-mint-hover);
            background: #f0fdfa;
            color: var(--brand-dark-teal);
        }
    </style>
</head>

<body>

    <!-- Landing Page Style Header Navbar -->
    <nav class="portal-navbar sticky-top">
        <div class="d-flex justify-content-between align-items-center max-w-1320 mx-auto">
            
            <!-- Brand Logo (Exact Font & Style from image) -->
            <div class="brand-text">
                <img src="{{ url_for('static', filename='images/logo.png') }}" width="38" alt="MindCare Logo">
                MindCare
            </div>

            <!-- Navigation Links (Exact links from image) -->
            <div class="nav-links-menu d-none d-lg-flex align-items-center gap-2">
                <a href="#" onclick="showSection('dashboard')" class="active">Home</a>
                <a href="#" onclick="showSection('profile')">About</a>
                <a href="#" onclick="showSection('resources')">Services</a>
                <a href="#" onclick="showSection('assessment')">Assessment</a>
                <a href="#" onclick="showSection('resources')">Resources</a>
                <a href="#" onclick="showSection('chat')">Contact</a>
            </div>

            <!-- Top Right Profile Avatar (Opens Offcanvas Sidebar) -->
            <div class="avatar-circle" data-bs-toggle="offcanvas" data-bs-target="#accountSidebar" aria-controls="accountSidebar" title="My Account Menu">
                {{ session['username'][0] | upper if session.get('username') else 'S' }}
            </div>

        </div>
    </nav>

    <!-- Side Drawer Navigation -->
    <div class="offcanvas offcanvas-end account-offcanvas p-3" tabindex="-1" id="accountSidebar" aria-labelledby="accountSidebarLabel">
        <div class="offcanvas-header pb-2">
            <h6 class="offcanvas-title text-uppercase fw-bold text-muted small" id="accountSidebarLabel">STUDENT NAVIGATION</h6>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body pt-0">
            <div class="profile-card-box">
                <div class="profile-avatar-large">
                    {{ session['username'][0] | upper if session.get('username') else 'S' }}
                </div>
                <div class="fw-bold fs-5 text-dark mb-1">
                    {{ session.get('username', 'Student Account') }}
                </div>
                <span class="badge bg-teal text-white rounded-pill px-3 py-1 text-uppercase fw-bold" style="background-color: var(--brand-mint-hover); font-size: 0.7rem;">
                    STUDENT PORTAL
                </span>
            </div>

            <a href="#" onclick="showSection('dashboard')" class="sidebar-menu-card" data-bs-dismiss="offcanvas">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-grid-1x2-fill text-teal"></i>
                    <span>Dashboard Overview</span>
                </div>
                <i class="bi bi-chevron-right text-muted small"></i>
            </a>

            <a href="#" onclick="showSection('profile')" class="sidebar-menu-card" data-bs-dismiss="offcanvas">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-bounding-box text-teal"></i>
                    <span>My Profile</span>
                </div>
                <i class="bi bi-chevron-right text-muted small"></i>
            </a>

            <a href="#" onclick="showSection('assessment')" class="sidebar-menu-card" data-bs-dismiss="offcanvas">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-clipboard2-check-fill text-teal"></i>
                    <span>Mental Assessments</span>
                </div>
                <i class="bi bi-chevron-right text-muted small"></i>
            </a>

            <a href="#" onclick="showSection('chat')" class="sidebar-menu-card" data-bs-dismiss="offcanvas">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-robot text-teal"></i>
                    <span>AI Wellness Assistant</span>
                </div>
                <i class="bi bi-chevron-right text-muted small"></i>
            </a>

            <a href="#" onclick="showSection('appointment')" class="sidebar-menu-card" data-bs-dismiss="offcanvas">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-calendar-event-fill text-teal"></i>
                    <span>Counsellor Sessions</span>
                </div>
                <i class="bi bi-chevron-right text-muted small"></i>
            </a>

            <a href="#" onclick="showSection('resources')" class="sidebar-menu-card" data-bs-dismiss="offcanvas">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-journal-bookmark-fill text-teal"></i>
                    <span>Wellness Resources</span>
                </div>
                <i class="bi bi-chevron-right text-muted small"></i>
            </a>

            <a href="#" onclick="showSection('mood')" class="sidebar-menu-card" data-bs-dismiss="offcanvas">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-activity text-teal"></i>
                    <span>Daily Mood Tracker</span>
                </div>
                <i class="bi bi-chevron-right text-muted small"></i>
            </a>

            <hr class="my-3 text-muted opacity-25">

            <a href="{{ url_for('logout') }}" class="sidebar-menu-card text-danger bg-danger-subtle">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-right text-danger"></i>
                    <span>Sign Out</span>
                </div>
                <i class="bi bi-chevron-right text-danger small"></i>
            </a>
        </div>
    </div>

    <!-- Main Workspace -->
    <main>

        <!-- DASHBOARD OVERVIEW -->
        <section id="dashboard" class="content-section">
            <div class="hero-section">
                <div class="container" style="max-width: 820px;">
                    <span class="hero-badge"><i class="bi bi-mortarboard-fill me-1"></i> Student Mental Health Workspace</span>
                    <h1 class="display-6 fw-bold mb-3" style="letter-spacing: -0.5px;">Welcome Back, <span style="color: var(--brand-mint);">{{ session.get('username', 'Student') }}</span></h1>
                    <p class="text-white-50 fs-6 mb-4 px-md-3" style="line-height: 1.6;">
                        This is your personal MindCare dashboard. Here you can track your mental health evaluation history, chat with our AI assistant for wellness guidance, book sessions with campus counsellors, and log your daily mood.
                    </p>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="{{ url_for('assessment') }}" class="btn btn-mint">Take New Assessment</a>
                        <a href="{{ url_for('chatbot') }}" class="btn btn-outline-mint">Chat with AI</a>
                    </div>
                </div>
            </div>

            <div class="container dashboard-container px-3 px-md-4" style="max-width: 1280px;">
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="card-custom p-4 text-center text-md-start">
                            <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Assessments Taken</span>
                            <h3 class="fw-bold mb-0" style="color: var(--brand-dark-teal);">04</h3>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card-custom p-4 text-center text-md-start">
                            <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Last Risk Status</span>
                            <h3 class="fw-bold text-success mb-0">Minimal</h3>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card-custom p-4 text-center text-md-start">
                            <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Appointments</span>
                            <h3 class="fw-bold mb-0" style="color: var(--brand-dark-teal);">01 Active</h3>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card-custom p-4 text-center text-md-start">
                            <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Weekly Mood Status</span>
                            <h3 class="fw-bold mb-0" style="color: var(--brand-dark-teal);">Stable</h3>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-lg-8">
                        <div class="card-custom p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0" style="color: var(--brand-dark-teal);">Recent Assessment Records</h5>
                                <a href="#" onclick="showSection('assessment')" class="text-decoration-none small fw-bold" style="color: var(--brand-mint-hover);">View All</a>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-custom border align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Date Recorded</th>
                                            <th>Evaluation Module</th>
                                            <th>Score</th>
                                            <th>Risk Level</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="text-muted">24 Jul 2026</td>
                                            <td class="fw-bold">General Anxiety Evaluation (GAD-7)</td>
                                            <td>04 / 21</td>
                                            <td><span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">Minimal Risk</span></td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">10 Jun 2026</td>
                                            <td class="fw-bold">Stress Evaluation Scale</td>
                                            <td>11 / 40</td>
                                            <td><span class="badge bg-info-subtle text-info px-3 py-2 rounded-pill">Moderate</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card-custom p-4 mb-4">
                            <h6 class="fw-bold mb-2" style="color: var(--brand-dark-teal);">MindCare AI Support</h6>
                            <p class="text-muted small mb-3">Talk with our AI assistant for mental health resources and coping strategies anytime.</p>
                            <a href="{{ url_for('chatbot') }}" class="btn btn-mint w-100 py-2">Open AI Chat Window</a>
                        </div>

                        <div class="card-custom p-4">
                            <h6 class="fw-bold mb-2" style="color: var(--brand-dark-teal);">Upcoming Consultation</h6>
                            <div class="p-3 bg-light rounded-3 border mb-3">
                                <div class="fw-bold text-dark">Dr. Sarah Jenkins</div>
                                <small class="text-muted d-block mb-1">Clinical Psychologist</small>
                                <span class="badge" style="background-color: var(--brand-dark-teal);">Tomorrow at 02:00 PM</span>
                            </div>
                            <a href="#" onclick="showSection('appointment')" class="btn btn-outline-secondary border w-100 btn-sm">Manage Appointments</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- PROFILE SECTION -->
        <section id="profile" class="content-section" style="display:none;">
            <div class="container py-5" style="max-width: 1280px;">
                <div class="card-custom p-4">
                    <h5 class="fw-bold mb-4" style="color: var(--brand-dark-teal);">My Student Profile Details</h5>
                    <table class="table table-borderless align-middle mb-0">
                        <tbody>
                            <tr>
                                <th width="20%" class="text-muted">Username</th>
                                <td class="fw-bold">{{ session.get('username', 'Student') }}</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Email Address</th>
                                <td class="fw-bold">{{ session.get('email', 'student@mindcare.com') }}</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Academic Class</th>
                                <td class="fw-bold">{{ student.class if student else 'N/A' }}</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Stream / Program</th>
                                <td class="fw-bold">{{ student.stream if student else 'N/A' }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ASSESSMENTS SECTION -->
        <section id="assessment" class="content-section" style="display:none;">
            <div class="container py-5" style="max-width: 1280px;">
                <div class="card-custom p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0" style="color: var(--brand-dark-teal);">Assessment History & Reports</h5>
                        <a href="{{ url_for('assessment') }}" class="btn btn-mint btn-sm">Take New Assessment</a>
                    </div>
                    <table class="table table-custom border align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Assessment Type</th>
                                <th>Score</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No new records found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- AI CHAT SECTION -->
        <section id="chat" class="content-section" style="display:none;">
            <div class="container py-5" style="max-width: 1280px;">
                <div class="card-custom p-5 text-center">
                    <h3 class="fw-bold mb-2" style="color: var(--brand-dark-teal);">MindCare AI Support Companion</h3>
                    <p class="text-muted max-w-md mx-auto mb-4" style="max-width: 500px;">
                        Connect with our AI companion for mindfulness exercises, academic stress guidance, and coping strategies.
                    </p>
                    <a href="{{ url_for('chatbot') }}" class="btn btn-mint px-4 py-2">Start AI Conversation</a>
                </div>
            </div>
        </section>

        <!-- APPOINTMENTS SECTION -->
        <section id="appointment" class="content-section" style="display:none;">
            <div class="container py-5" style="max-width: 1280px;">
                <div class="card-custom p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0" style="color: var(--brand-dark-teal);">Counselor Appointment Portal</h5>
                        <a href="{{ url_for('appointment') }}" class="btn btn-mint btn-sm">Schedule Appointment</a>
                    </div>
                    <table class="table table-custom border align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Counsellor</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No active appointments found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- RESOURCES SECTION -->
        <section id="resources" class="content-section" style="display:none;">
            <div class="container py-5" style="max-width: 1280px;">
                <div class="card-custom p-4">
                    <h5 class="fw-bold mb-3" style="color: var(--brand-dark-teal);">Student Wellness Resource Library</h5>
                    <a href="{{ url_for('resources') }}" class="btn btn-mint btn-sm">Browse Resources</a>
                </div>
            </div>
        </section>

        <!-- MOOD TRACKER SECTION -->
        <section id="mood" class="content-section" style="display:none;">
            <div class="container py-5" style="max-width: 1280px;">
                <div class="card-custom p-4">
                    <h5 class="fw-bold mb-3" style="color: var(--brand-dark-teal);">Daily Emotional Health Log</h5>
                    <div class="row g-3 mb-4">
                        <div class="col"><div class="mood-pill" onclick="selectMood(this)">Great</div></div>
                        <div class="col"><div class="mood-pill" onclick="selectMood(this)">Good</div></div>
                        <div class="col"><div class="mood-pill" onclick="selectMood(this)">Neutral</div></div>
                        <div class="col"><div class="mood-pill" onclick="selectMood(this)">Low</div></div>
                        <div class="col"><div class="mood-pill" onclick="selectMood(this)">Stressed</div></div>
                    </div>
                    <button class="btn btn-mint btn-sm px-4">Save Entry</button>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="text-white py-5 mt-5 border-top border-white border-opacity-10" style="background-color: var(--brand-deep-navy);">
        <div class="container" style="max-width: 1280px;">
            <div class="row g-4 mb-4">
                <div class="col-lg-5 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="{{ url_for('static', filename='images/logo.png') }}" width="34" alt="MindCare Logo">
                        <span class="fw-bold fs-5 text-white" style="letter-spacing: -0.5px;">Mind<span style="color: #2dd4bf;">Care</span></span>
                    </div>
                    <p class="text-white-50 small mb-3" style="max-width: 400px; line-height: 1.6;">
                        An AI-powered Digital Mental Health System developed for higher education students to manage wellness, track mood, and access counseling support.
                    </p>
                    <div class="small text-white-50">
                        <i class="bi bi-shield-check me-1" style="color: #2dd4bf;"></i> Confidential & Secure Student Portal
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">

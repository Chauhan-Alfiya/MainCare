<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Student Dashboard | MindCare</title>

    <!-- Bootstrap 5 CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet">

    <style>

        :root {

            --brand-dark-teal: #0e4a5c;
            --brand-deep-navy: #06232d;
            --brand-mint: #2dd4bf;
            --brand-mint-hover: #14b8a6;
            --bg-canvas: #f0f4f8;
            --card-border: #e2e8f0;

        }


        body {

            background-color: var(--bg-canvas);

            font-family:
                system-ui,
                -apple-system,
                "Segoe UI",
                Roboto,
                sans-serif;

            color: #1e293b;

        }


        /* ===========================
           TOP NAVBAR
        =========================== */

        .portal-navbar {

            background: #ffffff;

            border-bottom:
                1px solid var(--card-border);

            padding:
                16px 40px;

        }


        .brand-text {

            font-weight: 800;

            font-size: 1.5rem;

            color:
                var(--brand-dark-teal);

            letter-spacing:
                -0.5px;

            display: flex;

            align-items: center;

            gap: 6px;

        }


        .nav-links-menu a {

            color: #334155;

            font-weight: 600;

            font-size: 0.95rem;

            text-decoration: none;

            transition:
                color 0.2s ease;

            padding:
                6px 12px;

        }


        .nav-links-menu a:hover,
        .nav-links-menu a.active {

            color:
                var(--brand-dark-teal);

        }


        /* ===========================
           AVATAR
        =========================== */

        .avatar-circle {

            width: 44px;

            height: 44px;

            border-radius: 50%;

            background:
                var(--brand-dark-teal);

            color: #ffffff;

            font-weight: 700;

            font-size: 1.1rem;

            display: flex;

            align-items: center;

            justify-content: center;

            cursor: pointer;

            border: 2px solid #ffffff;

            box-shadow:
                0 3px 10px
                rgba(14, 74, 92, 0.2);

            transition:
                all 0.2s ease;

        }


        .avatar-circle:hover {

            transform: scale(1.05);

            background:
                var(--brand-mint-hover);

        }


        /* ===========================
           HERO
        =========================== */

        .hero-section {

            background:
                linear-gradient(
                    135deg,
                    var(--brand-deep-navy) 0%,
                    var(--brand-dark-teal) 100%
                );

            color: #ffffff;

            padding:
                55px 20px 95px 20px;

            border-bottom-left-radius:
                28px;

            border-bottom-right-radius:
                28px;

            text-align: center;

        }


        .hero-badge {

            background:
                rgba(45, 212, 191, 0.15);

            color:
                var(--brand-mint);

            padding:
                8px 20px;

            border-radius:
                30px;

            font-size:
                0.82rem;

            font-weight:
                600;

            display:
                inline-block;

            backdrop-filter:
                blur(6px);

            margin-bottom:
                18px;

            border:
                1px solid
                rgba(45, 212, 191, 0.25);

        }


        /* ===========================
           DASHBOARD CONTAINER
        =========================== */

        .dashboard-container {

            margin-top:
                -55px;

            padding-bottom:
                60px;

        }


        /* ===========================
           CUSTOM CARD
        =========================== */

        .card-custom {

            background:
                #ffffff;

            border:
                1px solid
                var(--card-border);

            border-radius:
                18px;

            box-shadow:
                0 4px 20px
                rgba(0, 0, 0, 0.04);

            transition:
                transform 0.2s,
                box-shadow 0.2s;

        }


        .card-custom:hover {

            transform:
                translateY(-3px);

            box-shadow:
                0 10px 25px
                rgba(0, 0, 0, 0.06);

        }


        /* ===========================
           FEATURE CARD
        =========================== */

        .feature-card {

            background:
                #ffffff;

            border:
                1px solid
                var(--card-border);

            border-radius:
                18px;

            padding:
                24px;

            height: 100%;

            box-shadow:
                0 4px 20px
                rgba(0, 0, 0, 0.04);

            transition:
                all 0.2s ease;

        }


        .feature-card:hover {

            transform:
                translateY(-4px);

            box-shadow:
                0 12px 28px
                rgba(0, 0, 0, 0.07);

        }


        .feature-icon {

            width: 52px;

            height: 52px;

            border-radius: 16px;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 1.35rem;

            margin-bottom: 16px;

        }


        .btn-mint {

            background-color:
                var(--brand-mint-hover);

            color:
                #ffffff;

            font-weight:
                600;

            border-radius:
                30px;

            padding:
                10px 24px;

            border:
                none;

            transition:
                all 0.2s ease;

            font-size:
                0.9rem;

        }


        .btn-mint:hover {

            background-color:
                #0d9488;

            color:
                #ffffff;

            transform:
                translateY(-2px);

        }


        /* ===========================
           OFFCANVAS
        =========================== */

        .account-offcanvas {

            width:
                330px !important;

            border-top-left-radius:
                24px;

            border-bottom-left-radius:
                24px;

            border:
                none;

            background:
                #ffffff;

            box-shadow:
                -10px 0 30px
                rgba(0, 0, 0, 0.08);

        }


        .profile-card-box {

            background:
                linear-gradient(
                    135deg,
                    #f0fdfa 0%,
                    #e6f4f8 100%
                );

            border-radius:
                20px;

            padding:
                24px 20px;

            text-align:
                center;

            border:
                1px solid #ccfbf1;

            margin-bottom:
                20px;

        }


        .profile-avatar-large {

            width:
                75px;

            height:
                75px;

            background:
                var(--brand-dark-teal);

            color:
                #ffffff;

            font-size:
                2rem;

            font-weight:
                800;

            border-radius:
                22px;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            margin:
                0 auto 12px auto;

            box-shadow:
                0 6px 16px
                rgba(14, 74, 92, 0.25);

        }


        .sidebar-menu-card {

            background-color:
                #f8fafc;

            border-radius:
                14px;

            padding:
                14px 18px;

            margin-bottom:
                10px;

            display:
                flex;

            align-items:
                center;

            justify-content:
                space-between;

            text-decoration:
                none;

            color:
                #334155;

            font-weight:
                600;

            font-size:
                0.92rem;

            transition:
                all 0.2s ease;

        }


        .sidebar-menu-card:hover {

            background-color:
                #ffffff;

            color:
                var(--brand-dark-teal);

            box-shadow:
                0 4px 12px
                rgba(14, 74, 92, 0.06);

        }


        /* ===========================
           INFO BOX
        =========================== */

        .info-label {

            font-size:
                0.75rem;

            text-transform:
                uppercase;

            letter-spacing:
                0.05em;

            color:
                #64748b;

            font-weight:
                700;

        }


        .info-value {

            font-weight:
                700;

            color:
                #1e293b;

        }


        /* ===========================
           SECTION
        =========================== */

        .content-section {

            min-height:
                400px;

        }


        /* ===========================
           RESPONSIVE
        =========================== */

        @media (max-width: 991px) {

            .portal-navbar {

                padding:
                    14px 20px;

            }

        }

    </style>

</head>


<body>


<!-- ===========================
     TOP NAVBAR
=========================== -->

<nav class="portal-navbar sticky-top">

    <div
        class="d-flex
               justify-content-between
               align-items-center">

        <!-- Brand -->

        <div class="brand-text">

            <img
                src="{{ url_for('static',
                filename='images/logo.png') }}"
                width="38"
                alt="MindCare Logo">

            MindCare

        </div>


        <!-- Navigation -->

        <div
            class="nav-links-menu
                   d-none
                   d-lg-flex
                   align-items-center
                   gap-2">

            <a
                href="#"
                onclick="showSection('dashboard')"
                class="active">

                Overview

            </a>


            <a
                href="#"
                onclick="showSection('assessment')">

                Assessment

            </a>


            <a
                href="#"
                onclick="showSection('appointments')">

                Appointments

            </a>


            <a
                href="#"
                onclick="showSection('wellness')">

                Wellness

            </a>

        </div>


        <!-- Avatar -->

        <div
            class="avatar-circle"
            data-bs-toggle="offcanvas"
            data-bs-target="#accountSidebar"
            aria-controls="accountSidebar"
            title="Student Menu">

            {{ session['username'][0] | upper
               if session.get('username')
               else 'S' }}

        </div>

    </div>

</nav>


<!-- ===========================
     STUDENT SIDE DRAWER
=========================== -->

<div
    class="offcanvas
           offcanvas-end
           account-offcanvas
           p-3"
    tabindex="-1"
    id="accountSidebar"
    aria-labelledby="accountSidebarLabel">


    <div class="offcanvas-header pb-2">

        <h6
            class="offcanvas-title
                   text-uppercase
                   fw-bold
                   text-muted
                   small"
            id="accountSidebarLabel">

            STUDENT PANEL

        </h6>


        <button
            type="button"
            class="btn-close text-reset"
            data-bs-dismiss="offcanvas"
            aria-label="Close">
        </button>

    </div>


    <div class="offcanvas-body pt-0">


        <!-- Profile -->

        <div class="profile-card-box">

            <div class="profile-avatar-large">

                {{ session['username'][0] | upper
                   if session.get('username')
                   else 'S' }}

            </div>


            <div
                class="fw-bold
                       fs-5
                       text-dark
                       mb-1">

                {{ student.username }}

            </div>


            <span
                class="badge
                       rounded-pill
                       px-3
                       py-1
                       text-uppercase
                       fw-bold"
                style="
                    background-color:
                    var(--brand-mint-hover);
                    color:#ffffff;
                    font-size:0.7rem;
                ">

                STUDENT

            </span>

        </div>


        <!-- Dashboard -->

        <a
            href="#"
            onclick="showSection('dashboard')"
            class="sidebar-menu-card"
            data-bs-dismiss="offcanvas">

            <div
                class="d-flex
                       align-items-center
                       gap-2">

                <i
                    class="bi bi-grid-1x2-fill"
                    style="color:var(--brand-dark-teal);">
                </i>

                <span>
                    Dashboard Overview
                </span>

            </div>

            <i
                class="bi bi-chevron-right
                       text-muted
                       small">
            </i>

        </a>


        <!-- Assessment -->

        <a
            href="{{ url_for('assessment') }}"
            class="sidebar-menu-card">

            <div
                class="d-flex
                       align-items-center
                       gap-2">

                <i
                    class="bi bi-clipboard2-pulse-fill"
                    style="color:var(--brand-dark-teal);">
                </i>

                <span>
                    Mental Health Assessment
                </span>

            </div>

            <i
                class="bi bi-chevron-right
                       text-muted
                       small">
            </i>

        </a>


        <!-- AI Chat -->

        <a
            href="{{ url_for('chatbot') }}"
            class="sidebar-menu-card">

            <div
                class="d-flex
                       align-items-center
                       gap-2">

                <i
                    class="bi bi-robot"
                    style="color:var(--brand-dark-teal);">
                </i>

                <span>
                    AI Chat Support
                </span>

            </div>

            <i
                class="bi bi-chevron-right
                       text-muted
                       small">
            </i>

        </a>


        <!-- Appointment -->

        <a
            href="{{ url_for('appointment') }}"
            class="sidebar-menu-card">

            <div
                class="d-flex
                       align-items-center
                       gap-2">

                <i
                    class="bi bi-calendar-check-fill"
                    style="color:var(--brand-dark-teal);">
                </i>

                <span>
                    Book Counselling
                </span>

            </div>

            <i
                class="bi bi-chevron-right
                       text-muted
                       small">
            </i>

        </a>


        <!-- Resources -->

        <a
            href="{{ url_for('resources') }}"
            class="sidebar-menu-card">

            <div
                class="d-flex
                       align-items-center
                       gap-2">

                <i
                    class="bi bi-book-fill"
                    style="color:var(--brand-dark-teal);">
                </i>

                <span>
                    Wellness Resources
                </span>

            </div>

            <i
                class="bi bi-chevron-right
                       text-muted
                       small">
            </i>

        </a>


        <!-- Logout -->

        <hr
            class="my-3
                   text-muted
                   opacity-25">


        <a
            href="{{ url_for('logout') }}"
            class="sidebar-menu-card
                   text-danger
                   bg-danger-subtle">

            <div
                class="d-flex
                       align-items-center
                       gap-2">

                <i
                    class="bi bi-box-arrow-right
                           text-danger">
                </i>

                <span>
                    Sign Out
                </span>

            </div>

            <i
                class="bi bi-chevron-right
                       text-danger
                       small">
            </i>

        </a>

    </div>

</div>


<!-- ===========================
     MAIN
=========================== -->

<main>


<!-- ===========================
     DASHBOARD OVERVIEW
=========================== -->

<section
    id="dashboard"
    class="content-section">


    <!-- HERO -->

    <div class="hero-section">

        <div
            class="container"
            style="max-width:820px;">


            <span
                class="hero-badge">

                <i
                    class="bi bi-shield-check me-1">
                </i>

                Personal Wellness Workspace

            </span>


            <h1
                class="display-6
                       fw-bold
                       mb-3"
                style="letter-spacing:-0.5px;">

                Welcome Back,

                <span
                    style="
                        color:var(--brand-mint);
                    ">

                    {{ student.username }}

                </span>

            </h1>


            <p
                class="text-white-50
                       fs-6
                       mb-4
                       px-md-3"
                style="line-height:1.6;">

                Take care of your mental well-being,
                track your wellness, complete assessments,
                connect with support, and access helpful
                resources through MindCare.

            </p>


        </div>

    </div>


    <!-- CONTENT -->

    <div
        class="container
               dashboard-container
               px-3
               px-md-4"
        style="max-width:1280px;">


        <!-- ===========================
             STUDENT PROFILE CARDS
        ============================ -->

        <div
            class="row
                   g-3
                   mb-4">


            <!-- Class -->

            <div
                class="col-6
                       col-md-3">

                <div
                    class="card-custom
                           p-4
                           text-center
                           text-md-start">

                    <span
                        class="info-label
                               d-block
                               mb-1">

                        Class

                    </span>


                    <h4
                        class="fw-bold
                               mb-0"
                        style="
                            color:
                            var(--brand-dark-teal);
                        ">

                        {{ student.class }}

                    </h4>

                </div>

            </div>


            <!-- Stream -->

            <div
                class="col-6
                       col-md-3">

                <div
                    class="card-custom
                           p-4
                           text-center
                           text-md-start">

                    <span
                        class="info-label
                               d-block
                               mb-1">

                        Stream

                    </span>


                    <h4
                        class="fw-bold
                               mb-0"
                        style="
                            color:
                            var(--brand-dark-teal);
                        ">

                        {{ student.stream }}

                    </h4>

                </div>

            </div>


            <!-- Assessment -->

            <div
                class="col-6
                       col-md-3">

                <div
                    class="card-custom
                           p-4
                           text-center
                           text-md-start">

                    <span
                        class="info-label
                               d-block
                               mb-1">

                        Mental Health

                    </span>


                    <h4
                        class="fw-bold
                               mb-0
                               text-success">

                        Assessment

                    </h4>

                </div>

            </div>


            <!-- Support -->

            <div
                class="col-6
                       col-md-3">

                <div
                    class="card-custom
                           p-4
                           text-center
                           text-md-start">

                    <span
                        class="info-label
                               d-block
                               mb-1">

                        Support

                    </span>


                    <h4
                        class="fw-bold
                               mb-0"
                        style="
                            color:
                            var(--brand-dark-teal);
                        ">

                        Available

                    </h4>

                </div>

            </div>


        </div>


        <!-- ===========================
             FEATURE CARDS
        ============================ -->

        <div
            class="row
                   g-4">


            <!-- Assessment -->

            <div
                class="col-lg-4
                       col-md-6">

                <div
                    class="feature-card">


                    <div
                        class="feature-icon"
                        style="
                            background:#ecfdf5;
                            color:#059669;
                        ">

                        <i
                            class="bi
                                   bi-clipboard2-pulse-fill">
                        </i>

                    </div>


                    <h5
                        class="fw-bold">

                        Mental Health Assessment

                    </h5>


                    <p
                        class="text-muted
                               small">

                        Complete PHQ-9 or GAD-7
                        assessments to understand
                        your current mental well-being.

                    </p>


                    <a
                        href="{{ url_for('assessment') }}"
                        class="btn btn-mint">

                        Take Assessment

                        <i
                            class="bi
                                   bi-arrow-right
                                   ms-1">
                        </i>

                    </a>

                </div>

            </div>


            <!-- AI Chat -->

            <div
                class="col-lg-4
                       col-md-6">

                <div
                    class="feature-card">


                    <div
                        class="feature-icon"
                        style="
                            background:#eff6ff;
                            color:#2563eb;
                        ">

                        <i
                            class="bi bi-robot">
                        </i>

                    </div>


                    <h5
                        class="fw-bold">

                        AI Chat Support

                    </h5>


                    <p
                        class="text-muted
                               small">

                        Talk to MindCare AI,
                        share how you are feeling,
                        and receive supportive guidance.

                    </p>


                    <a
                        href="{{ url_for('chatbot') }}"
                        class="btn btn-outline-primary">

                        Start Chat

                        <i
                            class="bi
                                   bi-arrow-right
                                   ms-1">
                        </i>

                    </a>

                </div>

            </div>


            <!-- Counselling -->

            <div
                class="col-lg-4
                       col-md-6">

                <div
                    class="feature-card">


                    <div
                        class="feature-icon"
                        style="
                            background:#f0fdfa;
                            color:#0f766e;
                        ">

                        <i
                            class="bi
                                   bi-calendar-heart">
                        </i>

                    </div>


                    <h5
                        class="fw-bold">

                        Counselling Support

                    </h5>


                    <p
                        class="text-muted
                               small">

                        Book a private counselling
                        appointment with a MindCare
                        counsellor.

                    </p>


                    <a
                        href="{{ url_for('appointment') }}"
                        class="btn btn-mint">

                        Book Appointment

                        <i
                            class="bi
                                   bi-arrow-right
                                   ms-1">
                        </i>

                    </a>

                </div>

            </div>


            <!-- Wellness -->

            <div
                class="col-lg-4
                       col-md-6">

                <div
                    class="feature-card">


                    <div
                        class="feature-icon"
                        style="
                            background:#fff7ed;
                            color:#ea580c;
                        ">

                        <i
                            class="bi
                                   bi-heart-pulse-fill">
                        </i>

                    </div>


                    <h5
                        class="fw-bold">

                        Daily Wellness

                    </h5>


                    <p
                        class="text-muted
                               small">

                        Keep track of your mood,
                        stress level, sleep and
                        personal wellness notes.

                    </p>


                    <a
                        href="#"
                        onclick="showSection('wellness')"
                        class="btn btn-outline-warning">

                        Track Wellness

                        <i
                            class="bi
                                   bi-arrow-right
                                   ms-1">
                        </i>

                    </a>

                </div>

            </div>


            <!-- Resources -->

            <div
                class="col-lg-4
                       col-md-6">

                <div
                    class="feature-card">


                    <div
                        class="feature-icon"
                        style="
                            background:#f5f3ff;
                            color:#7c3aed;
                        ">

                        <i
                            class="bi
                                   bi-book-half">
                        </i>

                    </div>


                    <h5
                        class="fw-bold">

                        Wellness Resources

                    </h5>


                    <p
                        class="text-muted
                               small">

                        Explore mental wellness
                        guides, educational content
                        and support resources.

                    </p>


                    <a
                        href="{{ url_for('resources') }}"
                        class="btn btn-outline-primary">

                        Explore Resources

                        <i
                            class="bi
                                   bi-arrow-right
                                   ms-1">
                        </i>

                    </a>

                </div>

            </div>


            <!-- Peer / Support -->

            <div
                class="col-lg-4
                       col-md-6">

                <div
                    class="feature-card">


                    <div
                        class="feature-icon"
                        style="
                            background:#fdf2f8;
                            color:#db2777;
                        ">

                        <i
                            class="bi
                                   bi-people-fill">
                        </i>

                    </div>


                    <h5
                        class="fw-bold">

                        Support Community

                    </h5>


                    <p
                        class="text-muted
                               small">

                        Stay connected with supportive
                        wellness activities and
                        student-friendly guidance.

                    </p>


                    <a
                        href="#"
                        class="btn btn-outline-secondary">

                        Coming Soon

                    </a>

                </div>

            </div>

        </div>


        <!-- ===========================
             QUICK WELLNESS SECTION
        ============================ -->

        <div
            class="row
                   g-4
                   mt-1">


            <!-- Profile -->

            <div
                class="col-lg-5">

                <div
                    class="card-custom
                           p-4">

                    <div
                        class="d-flex
                               align-items-center
                               gap-3
                               mb-4">

                        <div
                            class="feature-icon
                                   mb-0"
                            style="
                                background:#f0fdfa;
                                color:#0f766e;
                            ">

                            <i
                                class="bi
                                       bi-person-fill">
                            </i>

                        </div>


                        <div>

                            <h5
                                class="fw-bold
                                       mb-1">

                                My Profile

                            </h5>

                            <small
                                class="text-muted">

                                Your account information

                            </small>

                        </div>

                    </div>


                    <div
                        class="row
                               g-3">


                        <div
                            class="col-12">

                            <span
                                class="info-label
                                       d-block">

                                Full Name


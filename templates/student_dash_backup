<!-- ===========================
     SECTION SWITCHING
=========================== -->

<script>

    function showSection(sectionId) {

        const sections =
            document.querySelectorAll(
                ".content-section"
            );

        sections.forEach(
            function(section) {

                section.style.display = "none";

            }
        );


        const targetSection =
            document.getElementById(
                sectionId
            );


        if (targetSection) {

            targetSection.style.display =
                "block";

        }


        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });

    }

</script>


